# Local backend from device/simulator may not reach localhost reliably.
# Use reachable API URL for Expo mobile runtime.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:8000/api
EXPO_PUBLIC_API_URL=https://api-taskplanner.dastrevas.com/api
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_AUTH_REDIRECT_URI=https://auth.expo.io/@your-expo-username/smart-task-planner
EXPO_PUBLIC_APP_LAST_UPDATE=2026-06-20
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
